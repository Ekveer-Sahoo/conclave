{
  "name": "conclave",
  "version": "0.1.0",
  "description": "Event-sourced multi-model council for reviewing, planning, and executing coding work.",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r build && pnpm -r test",
    "typecheck": "pnpm --filter @conclave/core build && pnpm -r typecheck",
    "doctor": "pnpm build && pnpm --filter @conclave/orchestrator doctor",
    "web": "pnpm build && pnpm --filter @conclave/orchestrator web"
  }
}
