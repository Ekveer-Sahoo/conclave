{
  "name": "@conclave/orchestrator",
  "version": "0.1.0",
  "description": "Event-sourced multi-model council orchestrator for Conclave: CLI, web server, and session engine.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "conclave": "./dist/cli/index.js",
    "conclave-web": "./dist/web.js"
  },
  "files": [
    "dist",
    "public",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepack": "npm run build",
    "build": "tsc -p tsconfig.json && node scripts/copy-public.mjs && node scripts/chmod-bin.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --test-concurrency=4 --experimental-strip-types test/**/*.test.ts",
    "doctor": "node dist/cli/index.js doctor",
    "web": "node dist/web.js"
  },
  "dependencies": {
    "@conclave/core": "workspace:*",
    "better-sqlite3": "^11.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.7.0"
  }
}
